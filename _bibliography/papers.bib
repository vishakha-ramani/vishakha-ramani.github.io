@article{ramani2026queueing,
  title={An Approximate Queueing Model of {LLM} Inference Serving for {SLO}-Driven Autoscaling},
  author={Ramani, Vishakha and Tantawi, Asser N.},
  journal={arXiv preprint arXiv:2609.20957},
  year={2026},
  arxiv={2609.20957},
  pdf={https://arxiv.org/pdf/2609.20957},
  selected={true},
  abstract={We present a tractable approximate queueing model, built on Markovian assumptions, of how LLM inference servers interleave prefill and decode work. Each model-accelerator pair is described by three parameters: a fixed per-iteration overhead, a per-token compute cost, and a per-token KV-cache access cost. Mean-value analysis of per-iteration work is combined with a state-dependent Markov chain over batch occupancy to predict mean time to first token (TTFT) and inter-token latency (ITL), and the parameters can be fitted online from observed latencies. On an H100 GPU under light to moderate load, mean ITL error is about 5\% for Llama-3.1-8B and 8\% for Qwen2.5-14B, with TTFT errors of 14\% and 16\%. An autoscaling controller built on the model tracks a fourfold load ramp on an OpenShift H100 cluster, missing the SLO in 7 of 127 control cycles with in-loop median prediction errors of at most 5\% for TTFT and 9\% for ITL, compared with 27 of 128 cycles for a decode-throughput analyzer without a latency target.}
}

